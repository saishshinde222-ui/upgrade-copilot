{
  "name": "upgrade-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-powered dashboard that tracks dependencies across multiple GitHub repos and verifies upgrades safely in a sandbox before writing anything back.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/semver": "^7.5.8",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
