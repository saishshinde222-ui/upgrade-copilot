GITHUB_TOKEN=github_pat_xxx
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5-5
PORT=4000
# Required. Every route except /health rejects requests without this key (as the
# "X-API-Key" header, or "?apiKey=" query param for the SSE stream route, since
# EventSource can't set headers). Generate one with: openssl rand -hex 32
API_KEY=
